# ---- Server ----
PORT=3000
# Public base URL where this app is reachable (used for OAuth redirect + shareable link).
# In dev, http://localhost:3000 is fine. For production set your real URL.
PUBLIC_URL=http://localhost:3000

# ---- Business hours (24h, in the timezone below) ----
# Prospects can only book 30-minute slots within this window.
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
# Comma-separated list of weekday numbers that are business days.
# 0=Sun, 1=Mon, ... 6=Sat. Default: Mon-Fri
BUSINESS_DAYS=1,2,3,4,5
# IANA timezone for interpreting business hours, e.g. America/New_York
TIMEZONE=America/New_York
# Meeting length in minutes
MEETING_LENGTH_MIN=30
# Buffer (minutes) added before each meeting so back-to-back is avoided
MEETING_BUFFER_MIN=0
# How many days into the future to offer slots
BOOKING_HORIZON_DAYS=30
# Earliest a booking can be made, measured in hours from "now"
MIN_LEAD_HOURS=2

# ---- Google Calendar (optional but recommended) ----
# Create these at https://console.cloud.google.com/ (OAuth client -> Web application),
# enable the Google Calendar API, and add PUBLIC_URL/oauth/callback to authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Required participant (e.g. an assistant/colleague who must also be free) ----
# Their calendar must be shared with your Google account (at least "See only free/busy").
# PARTNER_CALENDAR_ID is usually their email address; it's added to the free/busy
# query so slots where they're busy are hidden. PARTNER_EMAIL adds them as an
# attendee on every booking so Google emails them a calendar invite.
PARTNER_NAME=Abigail
PARTNER_CALENDAR_ID=
PARTNER_EMAIL=
